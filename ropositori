    <!-- Script Logika & Keamanan PWA -->
    <script>
        // 1. Kalkulator Estimasi Otomatis
        function hitungEstimasi() {
            const tipe = document.getElementById('tipe-proyek').value;
            const luas = parseFloat(document.getElementById('luas-m2').value) || 0;
            const hari = parseFloat(document.getElementById('estimasi-hari').value) || 0;

            let tarifHari = 120000;
            if (tipe === 'baru') tarifHari = 150000;
            if (tipe === 'ruko') tarifHari = 180000;

            const totalTukang = tarifHari * hari;
            const totalAngkut = 500000; // Angkut flat
            const subtotal = totalTukang + totalAngkut;
            const escrowFee = subtotal * 0.02;
            const grandTotal = subtotal + escrowFee;

            document.getElementById('out-tukang').innerText = `Rp ${totalTukang.toLocaleString('id-ID')}`;
            document.getElementById('out-escrow').innerText = `Rp ${escrowFee.toLocaleString('id-ID')}`;
            document.getElementById('out-total').innerText = `Rp ${grandTotal.toLocaleString('id-ID')}`;

            return { totalTukang, grandTotal, hari, tipe };
        }

        document.getElementById('tipe-proyek').addEventListener('change', hitungEstimasi);
        document.getElementById('luas-m2').addEventListener('input', hitungEstimasi);
        document.getElementById('estimasi-hari').addEventListener('input', hitungEstimasi);
        hitungEstimasi();

        // 2. Kirim Estimasi ke WhatsApp
        function kirimEstimasiWA() {
            const data = hitungEstimasi();
            const pesan = `Halo TRI3X, saya ingin konsultasi estimasi proyek:\n- Tipe: ${data.tipe}\n- Durasi: ${data.hari} hari\n- Total Estimasi: Rp ${data.grandTotal.toLocaleString('id-ID')}`;
            const url = `https://wa.me/6281234567890?text=${encodeURIComponent(pesan)}`;
            window.open(url, '_blank', 'noopener,noreferrer');
        }

        // 3. PWA Service Worker Registration Safe Init
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration failed: ', err));
            });
        }
    </script>
